{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/payment-return", "destination": "/payment-return/index.html" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/shop/", "destination": "/index.html" }
  ],
  "headers": [{"source":"/payment-return(.*)","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Content-Type-Options","value":"nosniff"}]}]
}
